# Копия этого файла: cp .env.example .env

# ── Приложение ──────────────────────────────────────────────────────────────
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000

# Внешний адрес интерфейса. Сюда уходит редирект после входа через Яндекс.
# В разработке интерфейс живёт на отдельном порту, поэтому здесь 5173, а не 8000.
# В собранном виде, когда интерфейс отдаёт сервис, ставьте 8000.
APP_BASE_URL=http://localhost:5173

# Адрес сервиса. Сюда Яндекс возвращает человека после входа, значение должно
# совпадать с YANDEX_REDIRECT_URI.
SERVICE_BASE_URL=http://localhost:8000

# ── База данных ────────────────────────────────────────────────────────────
# Логин и пароль те же, что в docker-compose.yml
DATABASE_URL=postgresql+asyncpg://booking:booking@localhost:5432/booking

# ── Ключи ───────────────────────────────────────────────────────────────────
# Три ключа, каждый 32 байта в base64url. Генерируются так:
#   python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode().rstrip('='))"

# Подпись cookie сессии
SESSION_SECRET=ЗАПОЛНИТЬ

# Шифрование персональных данных, AES-256-GCM
PII_ENCRYPTION_KEY=ЗАПОЛНИТЬ

# Слепой индекс почты, HMAC-SHA256. Обязан отличаться от PII_ENCRYPTION_KEY
PII_LOOKUP_KEY=ЗАПОЛНИТЬ

# ── Яндекс ID OAuth ─────────────────────────────────────────────────────────
# Всё три берётся на https://oauth.yandex.ru/client/new/id/
# Тип приложения: для авторизации пользователей, платформа веб-сервисы.
# ClientID и пароль приложения лежат на странице приложения.
YANDEX_CLIENT_ID=ЗАПОЛНИТЬ
YANDEX_CLIENT_SECRET=ЗАПОЛНИТЬ

# Должно совпадать со значением Redirect URI в настройках приложения.
YANDEX_REDIRECT_URI=http://localhost:8000/auth/yandex/callback

# Права Телемоста. Пусто, пока их нет у приложения: Яндекс отвечает на право,
# которого нет в перечне при регистрации, ошибкой `invalid_scope` и отменяет
# всю авторизацию, а не только выдачу токена. Права добавляются в приложении
# на https://oauth.yandex.ru/client/<client_id>/info, и тогда сюда вписывается:
#   YANDEX_OPTIONAL_SCOPE=telemost-api:conferences.create telemost-api:conferences.read telemost-api:conferences.update
YANDEX_OPTIONAL_SCOPE=

# ── Почта, SMTP Яндекс ──────────────────────────────────────────────────────
# 465 это SSL, 587 это STARTTLS
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465

# Ящик, с которого отправляем. Он же адрес отправителя в письмах, отдельной
# переменной для него нет. Пароль приложения на
# https://id.yandex.ru/security/app-passwords, тип «Почта».
SMTP_USERNAME=ЗАПОЛНИТЬ
SMTP_PASSWORD=ЗАПОЛНИТЬ

# ── Напоминание о встрече ───────────────────────────────────────────────────
# За сколько минут до встречи уходит письмо со ссылкой. Значение по
# умолчанию рассчитано на реальную жизнь; при проверке его можно увеличить,
# чтобы не ждать.
REMINDER_LEAD_MINUTES=5
# Насколько широким окном воркер ловит встречи. Должно быть не меньше запаса.
REMINDER_WINDOW_MINUTES=7

# ── Документ о персональных данных ─────────────────────────────────────────
# Версия, которую гость принимает при отправке заявки. Та же строка должна
# быть в таблице consent_documents.
CONSENT_DOCUMENT_VERSION=2026-10-01