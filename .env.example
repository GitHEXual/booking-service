# Настройки приложения. Файл НЕ коммитится, см. .gitignore
#
# Этот файл описывает только формат: каждая переменная, что она значит и где
# взять значение. Копия с настоящими локальными ключами лежит в .env.

# ─────────────────────────────────────────────────────────────────────────────
# Приложение
# ─────────────────────────────────────────────────────────────────────────────

# local | staging | prod
APP_ENV=local

APP_HOST=0.0.0.0
APP_PORT=8000

# Внешний адрес сервиса. Нужен для проверки redirect_uri в OAuth и для ссылок
# в письмах. В разработке http://localhost:8000, в бою адрес из требований.
APP_BASE_URL=http://localhost:8000

# debug | info | warning | error
LOG_LEVEL=info


# ─────────────────────────────────────────────────────────────────────────────
# База данных
# ─────────────────────────────────────────────────────────────────────────────

# Схема asyncpg+psycopg. Локальная база поднимается docker compose.
DATABASE_URL=postgresql+asyncpg://booking:booking@localhost:5432/booking

# Логин и пароль в этой строке совпадают с POSTGRES_USER и POSTGRES_PASSWORD
# в docker-compose.yml. В бою это не «booking:booking».


# ─────────────────────────────────────────────────────────────────────────────
# Ключи приложения
# ─────────────────────────────────────────────────────────────────────────────

# Подпись cookie сессии эксперта. 32 случайных байта в base64url.
# Сгенерировать: python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode().rstrip('='))"
#
# Где взять: нигде, генерируется локально. В бою хранится в менеджере секретов.
# Потеря значения завершает все сессии, это безопасно и не страшно.
SESSION_SECRET=ЗАПОЛНИТЬ

# Ключ шифрования персональных данных, AES-256-GCM. Ровно 32 байта в base64url.
# Шифруются имя гостя, почта гостя и пароль встречи.
#
# Где взять: генерируется локально, см. команду выше.
# ВНИМАНИЕ: смена ключа без миграции всех строк делает существующие данные
# нечитаемыми. Процедура ротации не автоматизирована.
PII_ENCRYPTION_KEY=ЗАПОЛНИТЬ

# Ключ слепого индекса, HMAC-SHA256. Ровно 32 байта в base64url.
# Считается от нормализованной почты, нужен для поиска «моих заявок» по почте.
#
# Где взять: генерируется локально.
# ВНИМАНИЕ: это ДРУГОЙ ключ, он обязан отличаться от PII_ENCRYPTION_KEY.
# Один ключ на обе задачи лишает смысла разделение.
PII_LOOKUP_KEY=ЗАПОЛНИТЬ


# ─────────────────────────────────────────────────────────────────────────────
# Вход эксперта: Яндекс ID OAuth
# ─────────────────────────────────────────────────────────────────────────────

# Где взять всё в этом разделе:
#   1. Зайти в Яндекс OAuth под аккаунтом, который останется доступным навсегда:
#      https://oauth.yandex.ru/client/new/id/
#   2. Тип приложения: «Для авторизации пользователей». Именно этот, не
#      «Для доступа к API»: у второго redirect_uri не меняется.
#   3. Платформа «Веб-сервисы», в поле Redirect URI указать YANDEX_REDIRECT_URI
#      из этого файла. Для второго окружения добавить вторую строку.
#   4. В разделе «Доступ к данным» отметить: логин, имя и фамилия, адрес
#      электронной почты.
#   5. Скопировать ClientID и пароль приложения со страницы приложения.
#   6. ВНИМАНИЕ: без верификации пользователь увидит предупреждение перед
#      выдачей доступа. Для учебного проекта это приемлемо, для боя верификация
#      обязательна, иначе конверсия входа падает.
YANDEX_AUTH_CLIENT_ID=ЗАПОЛНИТЬ
YANDEX_AUTH_CLIENT_SECRET=ЗАПОЛНИТЬ

# Должен совпадать с тем, что указан в приложении, и с APP_BASE_URL.
YANDEX_REDIRECT_URI=http://localhost:8000/auth/yandex/callback

# Список логинов Яндекс ID, которым разрешён вход с ролью организатора.
# Пустое значение означает, что вход разрешён любому вошедшему, и роль
# организатора выдаётся автоматически при первом входе. Это осознанное
# допущение, см. docs/adr/0007.
ALLOWED_LOGINS=


# ─────────────────────────────────────────────────────────────────────────────
# Видеовстречи: Яндекс Телемост
# ─────────────────────────────────────────────────────────────────────────────

# Где взять:
#   1. Создать приложение на https://oauth.yandex.ru/client/new/
#      Тип: «Для доступа к API». В разделе «Доступ к данным» выбрать права
#      telemost-api:conferences.create, telemost-api:conferences.read,
#      telemost-api:conferences.update.
#   2. Открыть страницу приложения и скопировать ClientID.
#   3. Получить токен, открыв в браузере ссылку:
#      https://oauth.yandex.ru/authorize?response_type=token&client_id=<ClientID>
#      Яндекс покажет экран согласия, после входа токен окажется в адресной
#      строке страницы. Скопировать его сразу.
#   4. ВНИМАНИЕ: Яндекс не хранит выданные токены, найти его в личном кабинете
#      нельзя. Токен выдаётся заново, если потерян.
YANDEX_TELEMOST_CLIENT_ID=ЗАПОЛНИТЬ
YANDEX_TELEMOST_TOKEN=ЗАПОЛНИТЬ

# Базовый адрес API Телемоста. Меняется только при смене провайдера.
YANDEX_TELEMOST_API_BASE=https://cloud-api.yandex.net/v1

# Таймаут вызова создания встречи, секунды. Встреча создаётся уже после
# закрепления состава, поэтому долгий ответ не должен задерживать ответ гостю.
TELEMOST_TIMEOUT_SECONDS=5


# ─────────────────────────────────────────────────────────────────────────────
# Почта: SMTP Яндекс
# ─────────────────────────────────────────────────────────────────────────────

# Где взять:
#   1. В настройках Яндекс Почты включить «Разрешить доступ к почтовому ящику
#      с помощью почтовых клиентов» и «Пароли приложений и OAuth-токены»:
#      https://mail.yandex.com/#setup/client
#   2. Создать пароль приложения на https://passport.yandex.ru/app-passwords
#      Тип приложения: «Почта». Пароль показывают ОДИН раз.
SMTP_HOST=smtp.yandex.ru

# 465 это SSL, 587 это STARTTLS.
SMTP_PORT=465
SMTP_TLS_MODE=ssl

# Почтовый ящик, от имени которого идут письма.
SMTP_USERNAME=ЗАПОЛНИТЬ

# Пароль приложения из шага 2, а НЕ пароль от ящика.
SMTP_PASSWORD=ЗАПОЛНИТЬ

# Адрес отправителя в заголовке. Обычно совпадает с SMTP_USERNAME.
SMTP_FROM=ЗАПОЛНИТЬ

# Домен отправителя должен иметь записи SPF, DKIM и DMARC, иначе письма окажутся
# в спаме, хотя SMTP будет отвечать успехом. Проверить можно на
# https://www.mail-tester.com/ и через dig.


# ─────────────────────────────────────────────────────────────────────────────
# Фоновые задачи
# ─────────────────────────────────────────────────────────────────────────────

# Как часто воркер забирает письма из очереди и добивает неподтверждённые
# составы, секунды.
WORKER_POLL_SECONDS=30

# Сколько попыток отправки письма до того, как оно останется с ошибкой.
OUTBOX_MAX_ATTEMPTS=8


# ─────────────────────────────────────────────────────────────────────────────
# Согласие на обработку персональных данных
# ─────────────────────────────────────────────────────────────────────────────

# Версия документа, которую гость принимает при отправке заявки. Та же строка
# должна быть в таблице consent_documents.
CONSENT_DOCUMENT_VERSION=2026-10-01
